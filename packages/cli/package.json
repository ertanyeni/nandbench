{
  "name": "@gatecraft/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Headless gatecraft runner — compile + simulate + grade .json projects from the shell.",
  "type": "module",
  "bin": {
    "gatecraft-check": "./bin/gatecraft-check.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "tsx src/index.ts"
  },
  "dependencies": {
    "@gatecraft/app": "workspace:*",
    "@gatecraft/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
