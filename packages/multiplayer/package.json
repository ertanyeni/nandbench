{
  "name": "@gatecraft/multiplayer",
  "version": "0.0.0",
  "private": true,
  "description": "Real-time collaboration adapter — Yjs CRDT + y-websocket signaling for gatecraft documents.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "server": "tsx server/index.ts"
  },
  "dependencies": {
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "ws": "^8.18.0",
    "@types/ws": "^8.5.13"
  }
}
